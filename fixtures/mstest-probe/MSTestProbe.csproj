<Project Sdk="MSTest.Sdk">
  <!-- Ground truth for skills/mstest: scripts/verify.sh builds this under each TestingExtensionsProfile,
       compiles every API the skill names (ApiSurface.cs) and compares the help output with help/*.txt. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TestingExtensionsProfile Condition="'$(TestingExtensionsProfile)' == ''">AllMicrosoft</TestingExtensionsProfile>
  </PropertyGroup>
</Project>
