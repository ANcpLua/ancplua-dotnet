{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Submission Studio guided session v2",
  "type": "object",
  "required": [
    "schema_version",
    "session_id",
    "revision",
    "created_at",
    "updated_at",
    "synthetic",
    "paused",
    "source_path",
    "snapshot",
    "answers",
    "host_rows",
    "deferred",
    "artifacts",
    "history",
    "source_origin",
    "docs",
    "choices",
    "jobs"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "synthetic": {
      "type": "boolean"
    },
    "paused": {
      "type": "boolean"
    },
    "source_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "snapshot": {
      "type": [
        "object",
        "null"
      ]
    },
    "answers": {
      "type": "object"
    },
    "host_rows": {
      "type": "object"
    },
    "deferred": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "artifacts": {
      "type": "object"
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "detail",
          "at",
          "binding",
          "origin"
        ]
      }
    },
    "source_origin": {
      "type": "object"
    },
    "docs": {
      "type": "object"
    },
    "choices": {
      "type": "object"
    },
    "jobs": {
      "type": "object"
    },
    "understanding": {
      "type": [
        "object",
        "null"
      ]
    },
    "question_plan": {
      "type": [
        "object",
        "null"
      ]
    },
    "source_pending": {
      "type": [
        "object",
        "null"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "docs_mode": {
      "enum": [
        "live",
        "offline"
      ]
    }
  },
  "$comment": "The pure decision engine and adapter enforce step prerequisites, exact evidence bindings and external-observation provenance. This storage schema alone does not establish readiness or authenticate observers."
}
