{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Submission Studio product-host report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_kind",
    "host",
    "origin",
    "binding",
    "package_sha256",
    "observer",
    "observed_at",
    "environment",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "report_kind": {
      "const": "product-host"
    },
    "host": {
      "enum": [
        "chatgpt",
        "codex"
      ]
    },
    "origin": {
      "enum": [
        "observed",
        "synthetic"
      ]
    },
    "binding": {
      "type": "object",
      "required": [
        "integration_id",
        "source_revision",
        "input_sha256",
        "inventory_sha256"
      ]
    },
    "package_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "observer": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "environment": {
      "type": "object",
      "required": [
        "host_version",
        "runner_version"
      ],
      "properties": {
        "host_version": {
          "type": "string",
          "minLength": 1
        },
        "runner_version": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": "string"
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "expected",
          "status",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "expected": {},
          "status": {
            "enum": [
              "Passed",
              "Failed",
              "Blocked",
              "Not run",
              "Not applicable"
            ]
          },
          "evidence": {
            "type": "object",
            "required": [
              "file",
              "sha256"
            ],
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "capture": {
      "type": "object",
      "required": [
        "binding",
        "package_sha256",
        "host",
        "origin",
        "case_id",
        "status",
        "expected",
        "tool_calls",
        "side_effects"
      ],
      "properties": {
        "binding": {
          "type": "object",
          "required": [
            "integration_id",
            "source_revision",
            "input_sha256",
            "inventory_sha256"
          ]
        },
        "package_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "host": {
          "enum": [
            "chatgpt",
            "codex"
          ]
        },
        "origin": {
          "enum": [
            "observed",
            "synthetic"
          ]
        },
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "Passed",
            "Failed",
            "Blocked",
            "Not run",
            "Not applicable"
          ]
        },
        "expected": {},
        "observed": {},
        "assessment_rationale": {
          "type": "string"
        },
        "tool_calls": {
          "type": "array"
        },
        "side_effects": {
          "type": "object",
          "required": [
            "expected",
            "observed"
          ],
          "properties": {
            "expected": {},
            "observed": {}
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "Passed"
              }
            }
          },
          "then": {
            "required": [
              "observed",
              "assessment_rationale"
            ],
            "properties": {
              "observed": {
                "type": "string",
                "minLength": 1
              },
              "assessment_rationale": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  }
}
