{
  // Apply one rule set locally and in CI to the maintained skill packages.
  "globs": [
    "*.md", "docs/**/*.md",
    "packages/ancplua-dotnet/*.md", "packages/ancplua-dotnet/skills/**/*.md",
    "packages/mstest-extensions/AGENTS.md", "packages/mstest-extensions/README.md",
    "packages/mstest-extensions/skills/**/*.md",
    "packages/nami/*.md", "packages/nami/plugins/nami/skills/fixture-scope/**/*.md",
    "packages/nami/plugins/nami/skills/codex-native-messaging/**/*.md",
    "packages/prepare-plugin-submission/README.md",
    "packages/prepare-plugin-submission/skills/*/SKILL.md",
    "packages/prepare-plugin-submission/skills/*/references/evaluation.md"
  ],
  "ignores": ["**/node_modules/**", "**/artifacts/**", "**/bin/**", "**/obj/**", "**/.venv/**", "**/references/public-api.md"],
  "config": {
    "default": true,
    // API names and Markdown tables need long lines; compact tables are intentional.
    "MD013": false,
    "MD060": false,
    "MD024": { "siblings_only": true },
    "MD025": { "front_matter_title": "" }
  }
}
